# Comma-separated exact hostnames you own or are authorized to test
TRAFFICBOSS_ALLOWED_HOSTS=staging.example.com,qa.example.com
# Set a long random secret before starting the runner
TRAFFICBOSS_API_TOKEN=replace-with-a-long-random-secret
# Dashboard origin allowed to call this runner
TRAFFICBOSS_CORS_ORIGIN=https://trafficboss.pages.dev
TRAFFICBOSS_PORT=8787
